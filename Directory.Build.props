<Project>

  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <!--
      InvariantGlobalization is deliberately NOT set. It looks like a free saving for a
      background service, but WPF's font fallback constructs CultureInfo("en") during
      startup and throws outright in invariant mode, taking the preview window with it.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Freethrow</Product>
    <Authors>Freethrow contributors</Authors>
    <Copyright>Copyright (C) 2026 Freethrow contributors</Copyright>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/kramav/Freethrow</RepositoryUrl>
  </PropertyGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The preview demo is the instrument panel for the whole project: it is how frame
    rate, latency and allocation get read rather than assumed, and it grows to show
    landmarks, gesture state and attention as those land.

    OutputType is Exe rather than WinExe on purpose, so the same binary can answer the
    list and probe switches on a console without a window. Verifying capture on a new
    machine should not require a GUI.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>Freethrow.Demo.Preview</RootNamespace>
    <AssemblyName>Freethrow.Demo.Preview</AssemblyName>
    <StartupObject>Freethrow.Demo.Preview.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Freethrow.Core\Freethrow.Core.csproj" />
    <ProjectReference Include="..\..\src\Freethrow.Desktop\Freethrow.Desktop.csproj" />
  </ItemGroup>

</Project>

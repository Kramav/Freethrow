<Window x:Class="Freethrow.Demo.Preview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Freethrow.Demo.Preview"
        Title="Freethrow — Preview"
        Height="640"
        Width="900"
        Background="#FF12141A"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#FF9AA4B2" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   LastChildFill="False"
                   Margin="0,0,0,10">
            <TextBlock Text="Camera"
                       Foreground="{StaticResource Muted}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <ComboBox x:Name="DeviceSelector"
                      Width="380"
                      VerticalAlignment="Center"
                      DisplayMemberPath="DisplayName" />
            <Button x:Name="StartStopButton"
                    Content="Start"
                    Width="90"
                    Margin="10,0,0,0"
                    Padding="0,4"
                    Click="OnStartStopClick" />
            <CheckBox x:Name="MirrorToggle"
                      Content="Mirror"
                      IsChecked="True"
                      Foreground="{StaticResource Muted}"
                      VerticalAlignment="Center"
                      Margin="14,0,0,0"
                      Checked="OnMirrorChanged"
                      Unchecked="OnMirrorChanged" />
        </DockPanel>

        <Border Grid.Row="1"
                Background="Black"
                CornerRadius="4"
                ClipToBounds="True">
            <!--
                Image and overlay share one container so the mirror transform applies to
                both at once. Mirroring only the video would leave the skeleton reversed
                and sitting on the wrong side of the frame.
            -->
            <Grid RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="MirrorTransform" ScaleX="-1" />
                </Grid.RenderTransform>

                <Image x:Name="PreviewImage" Stretch="Uniform" />
                <local:SkeletonOverlay x:Name="Skeleton" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   x:Name="StatusText"
                   Margin="2,10,0,0"
                   FontFamily="Consolas"
                   FontSize="12"
                   Foreground="{StaticResource Muted}"
                   Text="Starting up…" />
    </Grid>
</Window>

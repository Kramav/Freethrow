<Window x:Class="Freethrow.Demo.Preview.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Freethrow.Demo.Preview"
        Title="Freethrow — Grab Calibration"
        Height="760"
        Width="900"
        Background="#FF12141A"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#FF9AA4B2" />
        <SolidColorBrush x:Key="Bright" Color="#FFE8EDF5" />
        <SolidColorBrush x:Key="Good" Color="#FF4ADE80" />
        <SolidColorBrush x:Key="Warn" Color="#FFF2A65A" />
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Prompt -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="StepLabel"
                       Foreground="{StaticResource Muted}"
                       FontSize="12"
                       Text="Step 1 of 3" />
            <TextBlock x:Name="PromptText"
                       Foreground="{StaticResource Bright}"
                       FontSize="22"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Text="Getting the camera ready…" />
            <TextBlock x:Name="HintText"
                       Foreground="{StaticResource Muted}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Text="" />
        </StackPanel>

        <!-- Live view. Image and overlay share a container so the mirror applies to both. -->
        <Border Grid.Row="1"
                Background="Black"
                CornerRadius="6"
                ClipToBounds="True">
            <Grid RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform ScaleX="-1" />
                </Grid.RenderTransform>
                <Image x:Name="PreviewImage" Stretch="Uniform" />
                <local:SkeletonOverlay x:Name="Skeleton" />
            </Grid>
        </Border>

        <!-- Live measurements and capture progress -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <ProgressBar x:Name="CaptureProgress"
                             Height="8"
                             Minimum="0"
                             Maximum="1"
                             Value="0"
                             Foreground="{StaticResource Good}"
                             Background="#FF232833"
                             BorderThickness="0" />
                <TextBlock x:Name="TrackingText"
                           Margin="0,8,0,0"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="{StaticResource Muted}"
                           Text="" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       x:Name="SampleCountText"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       FontFamily="Consolas"
                       FontSize="12"
                       Foreground="{StaticResource Muted}"
                       Text="" />
        </Grid>

        <!-- Actions -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">

            <StackPanel x:Name="ConfirmationPanel"
                        DockPanel.Dock="Left"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Text="Confirm corners with"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontSize="12"
                           Foreground="{StaticResource Muted}" />
                <ComboBox x:Name="ConfirmationMode"
                          Width="170"
                          VerticalAlignment="Center"
                          SelectionChanged="OnConfirmationModeChanged" />
            </StackPanel>

            <Button x:Name="PrimaryButton"
                    DockPanel.Dock="Right"
                    Content="Start capturing"
                    Width="150"
                    Padding="0,7"
                    IsDefault="True"
                    Click="OnPrimaryClick" />

            <Button x:Name="SecondaryButton"
                    DockPanel.Dock="Right"
                    Content="Redo this step"
                    Width="130"
                    Padding="0,7"
                    Margin="0,0,10,0"
                    Visibility="Collapsed"
                    Click="OnSecondaryClick" />

            <TextBlock x:Name="StatusText"
                       DockPanel.Dock="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"
                       FontSize="12"
                       Foreground="{StaticResource Muted}"
                       Text="" />
        </DockPanel>
    </Grid>
</Window>
